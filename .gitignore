# Virtual environments
venv/
env/
ENV/

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
pip-wheel-metadata/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# mypy
.mypy_cache/

# IDEs and editors
.vscode/
.idea/
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db

# Logs and runtime files
*.log
instance/
instance/*.sqlite

# dotenv files (may contain secrets)
.env
.env.*

# byte-compiled / optimized / DLL files
*.pyc
*.pyo
*.pyd

# backup files
*~
*.bak

# Keep inst.txt (instructions) in the repo — do not ignore it here